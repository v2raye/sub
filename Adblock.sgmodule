#!name=网页广告过滤（Surge 修正版）
#!desc=Pornhub / Xvideos request blocking and scoped Adblock4limbo HTML injection. Updated 2026-11-02.
#!author=limbopro; adapted from user-provided script
#!homepage=https://github.com/v2raye/sub
#!requirement=SYSTEM = 'iOS'

[URL Rewrite]
^https?:\/\/(?:cn|www)\.pornhub\.com\/_xa\/ads[^\s]* - reject
^https?:\/\/(?:www\.xvideos\.com|static-cdn77\.xvideos-cdn\.com)\/js\/static\/header\/sda\/ppsuma[^/?]*\.js(?:\?.*)?$ - reject

[Script]
adblock.html = type=http-response,pattern=^https?:\/\/(?:www\.pornhub\.com|cn\.pornhub\.com|www\.xvideos\.com)\/(?!.*\.(?:js|css|jpg|jpeg|png|webp|gif|svg|zip|woff|woff2|m3u8|mp4|mp3|json|ico|ttf|otf)(?:\?|$))(?!(?:api|my|account|authenticate|cdn-cgi|verify|auth|captcha)(?:/|\?|$)).*,requires-body=true,max-size=2097152,timeout=10,engine=jsc,script-path=https://raw.githubusercontent.com/v2raye/sub/main/Surge/Module/adblock/response.js,script-update-interval=86400

[MITM]
hostname = %APPEND% www.pornhub.com, cn.pornhub.com, www.xvideos.com, static-cdn77.xvideos-cdn.com
