# Anywhere native YouTube module — built from Anywhere/scripts/ using build.py
# Surge runtime and script-path syntax are intentionally NOT used.
# Features depend on live YouTube protocol and MITM compatibility.
[Module]
name = YouTube Enhance + Hide Shorts (Anywhere)
description = Native YouTube Protobuf UI cleanup and ads filtering; UMP streaming is intentionally excluded; no Premium entitlement.

[Routing]
name = YouTube Routing
routing = 0
2, youtube.com
2, youtu.be
2, youtube-nocookie.com
2, googlevideo.com
2, youtubei.googleapis.com
2, ytimg.com

[MITM]
name = YouTube Native MITM
# Suffixes only: Anywhere does not implement Surge's -redirector*.googlevideo.com exclusion.
hostname = youtubei.googleapis.com, googlevideo.com, www.youtube.com, s.youtube.com

# Ads and upload stats: return empty data; request quality hints are opt-in.
0, 100, ^https?://(?:youtubei\.googleapis\.com/youtubei/v1/(?:player/ad_break|log_event)(?:\?|$)|(?:www|s)\.youtube\.com/(?:pcs/|api/stats/(?:ads|qoe)|pagead|ptracking)|[\w-]+\.googlevideo\.com/(?:initplayback|videoplayback|dclk_video_ads|[^?]+\?.*oad)), 
# Native transparent URL rewrite: strip ad ctier segment on eligible CDN requests
0, 0, "^(https?://[\w-]+\.googlevideo\.com/(?!dclk_video_ads|initplayback(?:\?|$)).+?)&ctier=L(&.+?),ctier,(.+)$", 0, $1$2$3
# Independent non-overlapping response scripts; source is in Anywhere/scripts/
1, 100, ^https://youtubei\.googleapis\.com/youtubei/v1/(?:config|log_event)(?:\?|$), 
1, 100, ^https://youtubei\.googleapis\.com/youtubei/v1/(?:navigation/resolve_url|browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:\?|$), 

[Parameter]
1, 0, diagnostics, Diagnostic logging, Log matched endpoints and skip reasons; no query strings or key values., true, "[true, false]"
1, 0, block_ads, Block ads, Remove known ad placements and synthetic ad endpoints., true, "[true, false]"
1, 0, block_shorts, Hide Shorts, Hide identified Shorts tabs, cards and ad reel entries., true, "[true, false]"
1, 0, block_upload, Hide uploads, Hide upload guide entries., true, "[true, false]"
1, 0, auto_hd, Quality hint, Experimental quality hint; never invent Premium bitrate., false, "[true, false]"
1, 0, block_games, Hide games, Remove identified Playables shelf markers., true, "[true, false]"
1, 0, block_vertical_live, Hide vertical live, Remove identified vertical live shelf markers., false, "[true, false]"
1, 0, jump_ahead, Jump ahead, Adjust existing SmartSkip controls only; needs compatible UI., true, "[true, false]"
1, 0, block_store, Hide stores, Remove known shopping fields and shelf markers., true, "[true, false]"
1, 0, block_ai, Hide AI controls, Remove identified AI summary and Ask-AI card markers., true, "[true, false]"
