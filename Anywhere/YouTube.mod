# Full YouTube protocol port r3. See README for native platform differences.
#!category=YouTube
[Module]
name = YouTube
description = Full Surge protocol engine port; native Anywhere lifecycle; UMP buffers up to the app limit.
[Routing]
name = YouTube Routing
routing = 0
2, youtube.com
2, youtu.be
2, youtube-nocookie.com
2, googlevideo.com
2, youtubei.googleapis.com
2, ytimg.com
[MITM]
name = YouTube Native MITM
hostname = youtubei.googleapis.com, googlevideo.com, www.youtube.com, s.youtube.com
# Anywhere ctx headers are immutable: always remove cached-config hash on log_event to request fresh keys.
0,2,^https://youtubei\.googleapis\.com/youtubei/v1/log_event(?:\?.*)?$,x-youtube-hot-hash-data
0,100,^https?://(?!redirector[\w-]*\.googlevideo\.com/)(?:youtubei\.googleapis\.com/youtubei/v1/(?:player/ad_break|log_event)(?:\?.*)?$|(?:www|s)\.youtube\.com/(?:pcs/|api/stats/(?:ads|qoe)|pagead|ptracking)|[\w-]+\.googlevideo\.com/(?:initplayback|videoplayback|dclk_video_ads|[^?]+\?.*oad)),
0,0,^https?://www\.youtube\.com/pcs/,2
0,0,"(^https?://(?!redirector[\w-]*\.googlevideo\.com/)[\w-]+\.googlevideo\.com/(?!(?:dclk_video_ads|initplayback(?:\?|$))).+?)&ctier=L(&.+?),ctier,(.+)",1,$1$2$3
1,100,^https://youtubei\.googleapis\.com/youtubei/v1/(?:config|log_event)(?:\?.*)?$,
1,100,^https://youtubei\.googleapis\.com/youtubei/v1/(?:navigation/resolve_url|browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:\?.*)?$,
1,100,^https?://(?!redirector[\w-]*\.googlevideo\.com/)[\w-]+\.googlevideo\.com/initplayback(?:\?.*)?$,
[Parameter]
1,0,client_flavor,Client,Select YouTube or YouTube Music; response headers do not include request UA,youtube,"[youtube, youtubeMusic]"
1,0,block_shorts,Hide Shorts,true or false,true,"[true, false]"
1,0,block_upload,Hide uploads,true or false,true,"[true, false]"
1,0,auto_hd,Auto HD,true or false,true,"[true, false]"
1,0,block_games,Hide games,true or false,true,"[true, false]"
1,0,block_vertical_live,Hide vertical live,true or false,false,"[true, false]"
1,0,jump_ahead,Jump Ahead,true or false,true,"[true, false]"
1,0,block_store,Hide stores,true or false,true,"[true, false]"
1,0,block_ai,Hide AI,true or false,true,"[true, false]"
1,0,on_the_go,On-the-go controls,true or false,true,"[true, false]"
1,0,enable_ump,UMP processing,true or false,true,"[true, false]"
