#!name=CamScanner
#!category=CamScanner
#!author=chxm1023; Anywhere port
[Module]
name = CamScanner
description = Native Anywhere JSON response transformation for CamScanner property and privilege endpoints.
[MITM]
name = CamScanner
hostname = intsig.net, camscanner.com
1,100,^https?://(?:[\w-]+\.)*(?:intsig\.net|camscanner\.com)(?::\d+)?/(?:[^?#]*/)?(?:purchase/cs/query_property|queryProperty|getPrivilegeItem)(?:[/?]|$),
