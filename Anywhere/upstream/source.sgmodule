#!name=YouTube Enhance + Hide Shorts (Merged)
#!desc=YouTube Enhance + Aioneas Shorts EML filtering. Scripts hosted in v2raye/sub.
#!author=gholts, Maasea, DivineEngine, app2smile, ddgksf2013, Aioneas; merged adaptation
#!homepage=https://github.com/v2raye/sub/tree/main/Surge/Module
#!category=YouTube
#!arguments=block_upload:true,block_shorts:true,auto_hd:true,block_games:true,block_vertical_live:false,jump_ahead:true,block_store:true,block_ai:true,on_the_go:true
#!arguments-desc=block_upload\n  └ Remove upload tab\nblock_shorts\n  └ Remove Shorts tab and Shorts EML cards\nauto_hd\n  └ Prefer highest offered resolution; Premium bitrate when authorized\nblock_games\n  └ Remove Playables on homepage\nblock_vertical_live\n  └ Remove Vertical live on homepage\njump_ahead\n  └  Enable Jump Ahead button\nblock_store\n  └  Remove creator stores, product cards and overlays\nblock_ai\n  └ Remove Ask, AI summaries and related controls\non_the_go\n  └ On-the-go controls when compatible UI components are available
#!requirement=SYSTEM = 'iOS'

[Script]
youtube.enhance.ad-break = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$,engine=jsc,script-path=https://raw.githubusercontent.com/v2raye/sub/main/Surge/Module/youtube-merged/request.js
youtube.enhance.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,timeout=60,script-path=https://raw.githubusercontent.com/v2raye/sub/main/Surge/Module/youtube-merged/response.js,argument="{"blockUpload":{{{block_upload}}},"blockShorts":{{{block_shorts}}},"blockGames":{{{block_games}}},"blockVerticalLive":{{{block_vertical_live}}},"jumpAhead":{{{jump_ahead}}},"autoHd":{{{auto_hd}}},"blockStore":{{{block_store}}},"blockAi":{{{block_ai}}},"onTheGo":{{{on_the_go}}}}"
youtube.enhance.key = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:config|log_event)(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=jsc,script-path=https://raw.githubusercontent.com/v2raye/sub/main/Surge/Module/youtube-merged/key.js
youtube.enhance.ump = type=http-response,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,timeout=60,script-path=https://raw.githubusercontent.com/v2raye/sub/main/Surge/Module/youtube-merged/ump.js,argument="{"blockShorts":{{{block_shorts}}},"blockGames":{{{block_games}}},"blockVerticalLive":{{{block_vertical_live}}},"jumpAhead":{{{jump_ahead}}},"autoHd":{{{auto_hd}}},"blockStore":{{{block_store}}},"blockAi":{{{block_ai}}},"onTheGo":{{{on_the_go}}}}"
youtube.enhance.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=jsc,script-path=https://raw.githubusercontent.com/v2raye/sub/main/Surge/Module/youtube-merged/request.js,argument="{"autoHd":{{{auto_hd}}}}"
youtube.enhance.auto-hd = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=jsc,script-path=https://raw.githubusercontent.com/v2raye/sub/main/Surge/Module/youtube-merged/request.js,argument="{"autoHd":{{{auto_hd}}}}" #!REQUIREMENT "'{{{auto_hd}}}' == 'true'"
youtube.enhance.log-event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(?:\?.*)?$,engine=jsc,script-path=https://raw.githubusercontent.com/v2raye/sub/main/Surge/Module/youtube-merged/request.js

[URL Rewrite]
^https:\/\/www\.youtube\.com\/pcs\/ - reject
# ======= 视频广告请求 ======= #
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(?:dclk_video_ads|initplayback(?:\?|$))).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?|initplayback(?:\?|$))).+&oad data-type=text data=" " status-code=200

# ======= 通用广告请求 ======= #
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads data-type=text data=" " status-code=200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) data-type=text data=" " status-code=200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext data-type=text data=" " status-code=200

[MITM]
hostname = %APPEND% -redirector*.googlevideo.com, *.googlevideo.com, youtubei.googleapis.com, www.youtube.com, s.youtube.com
