#!name=京东去广告
#!desc=过滤已适配广告；默认保留正常入口。cleanup_ui=true 可开启额外页面精简。
#!category=去广告
#!author=RuCu6[https://github.com/RuCu6], Maasea[https://github.com/Maasea]
#!arguments=cleanup_ui:false
#!arguments-desc=默认关闭页面精简；true 会隐藏部分推荐、工具与服务入口。
# Source: https://github.com/fkingikelee/fkikelee/blob/d62650fa4b5d8c03f65f03ff0ec2e8afed3226c0/lpx/JD_remove_ads.lpx

[Rule]
URL-REGEX,^http:\/\/\w{32}\.jddebug\.com\/diagnose\?,REJECT
DOMAIN,dns.jd.com,REJECT

[Map Local]
^https?://dns\.jd\.com(?::(?:80|443))?(?:/|\?|$) data-type=text data="{}" status-code=503

[Script]
JD-OptionalUI = type=http-request,pattern=(?i)(?:(?:^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#]*&)?functionId=(searchBoxWord|stationPullService|uniformRecommend[06])(?:&|$))),timeout=5,script-path=https://raw.githubusercontent.com/v2raye/sub/main/Surge/Module/scripts/JD.js?v=20261107-audit1,argument="cleanup_ui={{{cleanup_ui}}}"
JD-Ads = type=http-response,pattern=(?i)(?:(?:^https:\/\/api\.m\.jd\.com\/client\.action(?:\?|$))),requires-body=true,max-size=2097152,timeout=5,script-path=https://raw.githubusercontent.com/v2raye/sub/main/Surge/Module/scripts/JD.js?v=20261107-audit1,argument="cleanup_ui={{{cleanup_ui}}}"

[MITM]
hostname = %APPEND% api.m.jd.com, dns.jd.com
