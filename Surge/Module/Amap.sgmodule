# Source: https://github.com/fkingikelee/fkikelee/blob/d62650fa4b5d8c03f65f03ff0ec2e8afed3226c0/lpx/Amap_remove_ads.lpx

[Map Local]
(?i)^https://m[56]\.amap\.com/ws/(?:valueadded|aos)/alimama/splash_screen/?(?:\?|$) data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"

[Script]
Amap-AMDC = type=http-request,pattern=(?i)^https?://amdc\.m\.taobao\.com(?::(?:80|443))?/amdc/mobileDispatch/?(?:\?|$),timeout=5,script-path=https://raw.githubusercontent.com/v2raye/sub/main/Surge/Module/scripts/AMDC.js?v=20261110-splash2
Amap-Ads = type=http-response,pattern=(?i)(?:(?:^https:\/\/m5\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable\/1\?)|(?:^https:\/\/m5\.amap\.com\/ws\/shield\/dsp\/profile\/index\/nodefaasv3\?)|(?:^https:\/\/m5\.amap\.com\/ws\/shield\/scene\/recommend\?)|(?:^https:\/\/sns\.amap\.com\/ws\/opc\/tools\/list\?)|(?:^https:\/\/info\.amap\.com\/ws\/c3frontend\/af-search\/search\?)|(?:^https:\/\/m5-zb\.amap\.com\/ws\/boss\/car\/order\/content_info\?)|(?:^https:\/\/m5-zb\.amap\.com\/ws\/amap\/hitch\/passenger\/content_info\?)|(?:^https:\/\/center\.amap\.com\/ws\/amc\/server\/conv\/raise_list\?)|(?:^https:\/\/info\.amap\.com\/ws\/shield\/search_business\/process\/middleLayer\/sug\?)|(?:^https:\/\/info\.amap\.com\/ws\/shield\/search\/poi\/detail\?)|(?:^https:\/\/m5\.amap\.com\/ws\/smartui\/near_recommend\?)|(?:^https://m5\.amap\.com/ws/shield/search_business/process/marketingOperationStructured(?:\?|$))),requires-body=true,max-size=2097152,timeout=5,script-path=https://raw.githubusercontent.com/v2raye/sub/main/Surge/Module/scripts/Amap.js?v=20261111-ads-only

[MITM]
hostname = %APPEND% m5.amap.com, ai.amap.com, m5-zb.amap.com, center.amap.com, sns.amap.com, info.amap.com, m6.amap.com, amdc.m.taobao.com
