#!name=高德地图去广告
#!desc=移除开屏广告、首页推荐、搜索推荐、打车广告、地点推荐及广告，精简我的页面。（Surge 转换版；含原版页面精简）
#!category=去广告
#!author=可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
# Source: https://github.com/fkingikelee/fkikelee/blob/d62650fa4b5d8c03f65f03ff0ec2e8afed3226c0/lpx/Amap_remove_ads.lpx
# Script snapshot: https://raw.githubusercontent.com/v2raye/sub/main/Surge/Module/scripts/Amap.js

[Map Local]
(?i)^https:\/\/m5\.amap\.com\/ws\/valueadded\/alimama\/splash_screen\? data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
(?i)^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/main-page-assets\? data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
(?i)^https:\/\/m5\.amap\.com\/ws\/faas\/amap-navigation\/main-page-aiqs\? data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
(?i)^https:\/\/ai\.amap\.com\/v1\/ai_rec\/home_qs\? data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
(?i)^https:\/\/m5-zb\.amap\.com\/ws\/promotion-web\/resource(\/home)?\? data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
(?i)^https:\/\/m5\.amap\.com\/ws\/info_bff\/rankingCard\? data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"
(?i)^https:\/\/m5\.amap\.com\/ws\/shield\/search_business\/process\/marketingOperationStructured\? data-type=text data="{}" status-code=200 header="Content-Type:application/json; charset=utf-8"

[Script]
Amap-Ads = type=http-response,pattern=(?i)(?:(?:^https:\/\/m5\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable\/1\?)|(?:^https:\/\/m5\.amap\.com\/ws\/shield\/dsp\/profile\/index\/nodefaasv3\?)|(?:^https:\/\/m5\.amap\.com\/ws\/shield\/scene\/recommend\?)|(?:^https:\/\/sns\.amap\.com\/ws\/opc\/tools\/list\?)|(?:^https:\/\/info\.amap\.com\/ws\/c3frontend\/af-search\/search\?)|(?:^https:\/\/m5-zb\.amap\.com\/ws\/boss\/car\/order\/content_info\?)|(?:^https:\/\/m5-zb\.amap\.com\/ws\/amap\/hitch\/passenger\/content_info\?)|(?:^https:\/\/center\.amap\.com\/ws\/amc\/server\/conv\/raise_list\?)|(?:^https:\/\/info\.amap\.com\/ws\/shield\/search_business\/process\/middleLayer\/sug\?)|(?:^https:\/\/info\.amap\.com\/ws\/shield\/search\/poi\/detail\?)|(?:^https:\/\/m5\.amap\.com\/ws\/smartui\/near_recommend\?)),requires-body=true,max-size=2097152,timeout=5,script-path=https://raw.githubusercontent.com/v2raye/sub/main/Surge/Module/scripts/Amap.js

[MITM]
hostname = %APPEND% m5.amap.com, ai.amap.com, m5-zb.amap.com, center.amap.com, sns.amap.com, info.amap.com
